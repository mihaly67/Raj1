[Desktop Entry]
Version=1.0
Type=Application
Name=Rendszer Monitor
Comment=Htop + Nvtop vizuális összevonás (KDE Stílus)
Exec=bash -c 'export DISPLAY=:0 && export XAUTHORITY=/home/Jules/.Xauthority && cd /home/Jules/HardverMonitor_dev && /home/Jules/jules_venv/bin/python hardware_monitor_v2.py'
Icon=utilities-system-monitor
Terminal=false
StartupNotify=true
Categories=System;Monitor;
