[Desktop Entry]
Version=1.0
Type=Application
Name=Hardver Monitor (Autostart)
Comment=Htop + Nvtop vizuális összevonás (KDE Stílus)
Exec=bash -c 'export DISPLAY=:0 && export XAUTHORITY=/home/Jules/.Xauthority && cd /home/Jules/HardverMonitor_dev && /home/Jules/jules_venv/bin/python hardware_monitor_v2.py --hidden'
Icon=utilities-system-monitor
Terminal=false
StartupNotify=false
Categories=System;Monitor;
